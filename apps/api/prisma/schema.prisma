// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id            String   @id @default(uuid())
  name          String
  nickname      String?  @unique
  email         String   @unique
  password_hash String
  createdAt     DateTime @default(now())

  rachaMemberships     RachaMember[]
  createdRachas        Racha[]               @relation("RachaCreatedBy")
  players              Player[]
  teamSplits           TeamSplit[]           @relation("TeamSplitCreatedBy")
  teamSplitResults     TeamSplit[]           @relation("TeamSplitResultRecordedBy")
  teamSplitPlayerStats TeamSplitPlayerStat[]
}

enum RachaMemberRole {
  admin
  member
}

model Racha {
  id                     String   @id @default(uuid())
  name                   String
  schedule               String?
  evaluationsOpen        Boolean  @default(false)
  // Quando true, qualquer membro do racha pode gerar uma divisão de times
  // (RF05 extra) — por padrão só o admin pode. Quem gerou e quando já ficam
  // registrados no TeamSplit (createdBy/createdAt) independente disso.
  teamSplitOpenToMembers Boolean  @default(false)
  createdBy              String
  creator                Users    @relation("RachaCreatedBy", fields: [createdBy], references: [id])
  createdAt              DateTime @default(now())
  // Link de convite (RF02 extra): quem tiver esse código entra como membro
  // automaticamente ao se cadastrar/logar pelo link. O admin pode gerar um
  // código novo pra invalidar o link anterior.
  inviteCode             String   @unique @default(uuid())

  members     RachaMember[]
  players     Player[]
  evaluations Evaluation[]
  teamSplits  TeamSplit[]
}

model RachaMember {
  id       String          @id @default(uuid())
  rachaId  String
  racha    Racha           @relation(fields: [rachaId], references: [id], onDelete: Cascade)
  userId   String
  user     Users           @relation(fields: [userId], references: [id])
  role     RachaMemberRole
  joinedAt DateTime        @default(now())

  @@unique([rachaId, userId])
  @@index([userId])
}

model Player {
  id            String  @id @default(uuid())
  rachaId       String
  racha         Racha   @relation(fields: [rachaId], references: [id], onDelete: Cascade)
  // Nulo para jogador avulso (RF03 extra): não tem conta no sistema, só
  // participa deste racha por uma vez. `guestName` é obrigatório nesse caso.
  userId        String?
  user          Users?  @relation(fields: [userId], references: [id])
  guestName     String?
  goals         Int     @default(0)
  assists       Int     @default(0)
  manualAverage Float?

  evaluationsReceived Evaluation[]          @relation("EvaluatedPlayer")
  evaluationsGiven    Evaluation[]          @relation("EvaluatorPlayer")
  matchStats          TeamSplitPlayerStat[]

  @@unique([rachaId, userId])
}

model Evaluation {
  id                String   @id @default(uuid())
  rachaId           String
  racha             Racha    @relation(fields: [rachaId], references: [id], onDelete: Cascade)
  evaluatedPlayerId String
  evaluatedPlayer   Player   @relation("EvaluatedPlayer", fields: [evaluatedPlayerId], references: [id], onDelete: Cascade)
  evaluatorPlayerId String
  evaluatorPlayer   Player   @relation("EvaluatorPlayer", fields: [evaluatorPlayerId], references: [id], onDelete: Cascade)
  // Nulo = abstenção registrada ("não sei"/"não consigo opinar" — RF03 extra).
  score             Float?
  createdAt         DateTime @default(now())

  @@unique([rachaId, evaluatedPlayerId, evaluatorPlayerId])
}

enum TeamSplitOutcome {
  team_win
  draw
}

model TeamSplit {
  id        String   @id @default(uuid())
  rachaId   String
  racha     Racha    @relation(fields: [rachaId], references: [id], onDelete: Cascade)
  createdBy String
  creator   Users    @relation("TeamSplitCreatedBy", fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
  params    Json
  teams     Json

  // Resultado da partida (RF04 extra) — nulo enquanto não registrado. Times
  // não têm identidade persistente entre divisões diferentes (o índice é
  // recriado a cada geração), então o resultado é só "quem venceu nessa
  // ocasião"; ranking por jogador (não por time) é quem agrega isso ao
  // longo do tempo.
  outcome              TeamSplitOutcome?
  winningTeamIndex     Int?
  resultRecordedBy     String?
  resultRecordedByUser Users?            @relation("TeamSplitResultRecordedBy", fields: [resultRecordedBy], references: [id])
  resultRecordedAt     DateTime?

  playerStats TeamSplitPlayerStat[]

  @@index([rachaId, createdAt])
}

// Gols/assistências de um jogador numa divisão de times específica (RF04
// extra — "acompanhar" um jogo pontual). O total exibido em Player.goals/
// assists (RF03.3) soma o valor manual de base com todos esses registros por
// partida, no mesmo espírito de Player.average (baseline + agregação
// dinâmica) — dá pra corrigir só o jogo de uma data específica sem afetar as
// outras.
model TeamSplitPlayerStat {
  id             String    @id @default(uuid())
  teamSplitId    String
  teamSplit      TeamSplit @relation(fields: [teamSplitId], references: [id], onDelete: Cascade)
  playerId       String
  player         Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  goals          Int       @default(0)
  assists        Int       @default(0)
  recordedBy     String
  recordedByUser Users     @relation(fields: [recordedBy], references: [id])
  recordedAt     DateTime  @default(now())

  @@unique([teamSplitId, playerId])
  @@index([playerId])
}
