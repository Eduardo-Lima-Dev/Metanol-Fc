// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "commonjs"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id            String   @id @default(uuid())
  name          String
  nickname      String?  @unique
  email         String   @unique
  password_hash String
  createdAt     DateTime @default(now())

  rachaMemberships RachaMember[]
  createdRachas    Racha[]       @relation("RachaCreatedBy")
  players          Player[]
}

enum RachaMemberRole {
  admin
  member
}

model Racha {
  id              String   @id @default(uuid())
  name            String
  schedule        String?
  evaluationsOpen Boolean  @default(false)
  createdBy       String
  creator         Users    @relation("RachaCreatedBy", fields: [createdBy], references: [id])
  createdAt       DateTime @default(now())

  members     RachaMember[]
  players     Player[]
  evaluations Evaluation[]
}

model RachaMember {
  id       String          @id @default(uuid())
  rachaId  String
  racha    Racha           @relation(fields: [rachaId], references: [id], onDelete: Cascade)
  userId   String
  user     Users           @relation(fields: [userId], references: [id])
  role     RachaMemberRole
  joinedAt DateTime        @default(now())

  @@unique([rachaId, userId])
  @@index([userId])
}

model Player {
  id            String  @id @default(uuid())
  rachaId       String
  racha         Racha   @relation(fields: [rachaId], references: [id], onDelete: Cascade)
  userId        String
  user          Users   @relation(fields: [userId], references: [id])
  goals         Int     @default(0)
  assists       Int     @default(0)
  manualAverage Float?

  evaluationsReceived Evaluation[] @relation("EvaluatedPlayer")
  evaluationsGiven    Evaluation[] @relation("EvaluatorPlayer")

  @@unique([rachaId, userId])
}

model Evaluation {
  id                String   @id @default(uuid())
  rachaId           String
  racha             Racha    @relation(fields: [rachaId], references: [id], onDelete: Cascade)
  evaluatedPlayerId String
  evaluatedPlayer   Player   @relation("EvaluatedPlayer", fields: [evaluatedPlayerId], references: [id], onDelete: Cascade)
  evaluatorPlayerId String
  evaluatorPlayer   Player   @relation("EvaluatorPlayer", fields: [evaluatorPlayerId], references: [id], onDelete: Cascade)
  score             Float
  createdAt         DateTime @default(now())

  @@unique([rachaId, evaluatedPlayerId, evaluatorPlayerId])
}
